# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API). .env.local is git-ignored; never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional locally, but set it in production (a warning is logged if it's missing). Contact (email or URL) put in the User-Agent of address lookups to
# the public Nominatim geocoder, which asks apps to identify themselves
# (operations.osmfoundation.org/policies/nominatim/). Server-side only.
GEOCODING_CONTACT=

# Server-only, never NEXT_PUBLIC_. Bypasses RLS entirely, so it is used in exactly
# one place (src/lib/supabase/admin.ts) to change a user's email without Supabase
# sending confirmation emails. Without it, changing the email on the account
# page shows "not available" (everything else keeps working). Project Settings
# -> API -> service_role. Set it in production too.
SUPABASE_SERVICE_ROLE_KEY=
